# Tutor Booking Glass runs its own API, UI, demo database, and static assets.
# Copy this file to .env for local use. Never commit real values.
PORT=3000

# Required for the admin panel. Choose a strong new password.
ADMIN_KEY=change-me

# Google Sheets / Apps Script (leave APPS_SCRIPT_URL empty to use demo data).
# API_SECRET must exactly match the secret in your Apps Script deployment.
API_SECRET=
APPS_SCRIPT_URL=
SHEET_URL=

# Telegram (optional, but required for bot / reminders / admin messaging).
BOT_TOKEN=
ADMIN_CHAT_ID=
# The NEW Render URL, with no trailing slash.
PUBLIC_URL=http://localhost:3000

# Initial defaults. They can later be changed in Admin → Settings.
TUTOR_NAME=Онлайн-уроки
TUTOR_PHONE=
TUTOR_SUBJECTS=Математика,Физика
TZ_LABEL=МСК+2
TUTOR_TG=aviation09
LESSON_DURATION=50
RESCHEDULE_HOURS=12
